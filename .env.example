# ── Enhanced AI (optional) ──────────────────────────────────────────
# Without a key, Fitted runs its free on-device engine for everything.
# With a key, job analysis, optimization, review, interview prep, chat and
# CV import use Claude — every result is still schema-validated and checked
# by the local truthfulness guard.
ANTHROPIC_API_KEY=

# Optional model override (default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Set to 1 to force the on-device engine even if a key is present
# FITTED_DISABLE_CLAUDE=0

# ── SEO (optional) ──────────────────────────────────────────────────
# Public site URL for the sitemap and social previews. On Vercel this defaults
# to the project's production domain, so you normally don't need to set it.
# NEXT_PUBLIC_SITE_URL=https://fitted.cv
# Google Search Console "HTML tag" verification code (content="..." value only)
# GOOGLE_SITE_VERIFICATION=

# ── PDF export (optional) ───────────────────────────────────────────
# Server-side PDF uses headless Chrome via Puppeteer. If Puppeteer's bundled
# browser isn't installed, a locally installed Chrome/Edge is detected
# automatically, or point to one here. Otherwise the app falls back to the
# browser's print dialog.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
